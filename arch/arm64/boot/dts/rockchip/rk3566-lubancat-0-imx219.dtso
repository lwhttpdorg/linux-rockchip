/*
 * Raspberry Pi Camera Module V2 (IMX219) overlay for LubanCat Zero W.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/media/video-interfaces.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	imx219_clk: clock-imx219 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "imx219_xclk";
	};

	cam_vana_2v8: regulator-camera-vana {
		compatible = "regulator-fixed";
		regulator-name = "cam_vana_2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&cam_sensor_en>;
	};

	cam_vdig_1v8: regulator-camera-vdig {
		compatible = "regulator-fixed";
		regulator-name = "cam_vdig_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&cam_sensor_en>;
	};

	cam_vddl_1v2: regulator-camera-vddl {
		compatible = "regulator-fixed";
		regulator-name = "cam_vddl_1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		vin-supply = <&cam_sensor_en>;
	};
};

&imx415 {
	status = "disabled";
};

/*
 * The LubanCat-to-Raspberry-Pi adapter routes CAM_PWDN to CAM_IO0.
 * Raspberry Pi Camera Module V2 uses CAM_IO0 as an active-high power enable,
 * unlike the active-low enable expected by the IMX415 module.
 */
&cam_sensor_en {
	enable-active-high;
	gpio = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	imx219: camera@10 {
		compatible = "sony,imx219";
		reg = <0x10>;
		clocks = <&imx219_clk>;
		VANA-supply = <&cam_vana_2v8>;
		VDIG-supply = <&cam_vdig_1v8>;
		VDDL-supply = <&cam_vddl_1v2>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_reset>;
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		port {
			imx219_out: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				clock-noncontinuous;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <456000000>;
				remote-endpoint = <&lubancat_dphy_input>;
			};
		};
	};
};

&lubancat_dphy_input {
	clock-noncontinuous;
	remote-endpoint = <&imx219_out>;
};

&rkisp {
	max-input = <3280 2464 15>;
};
